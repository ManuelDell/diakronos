frontend/dist/

# SPA-Build-Artefakte (werden von `npm run build` erzeugt; im Docker-Image
# baut Stage 1 sie frisch). Verhindert, dass Hunderte Bundle-Dateien ins Repo
# gelangen und jeden Diff unlesbar machen.

# Frontend-Dependencies (werden per npm ci installiert).
# Beide Schreibweisen: mit Schraegstrich nur das Verzeichnis, ohne Schraegstrich
# auch eine Datei oder einen SYMLINK dieses Namens (B1: ein committeter Link
# `frontend/node_modules` brach den Merge im Haupt-Checkout ab).
frontend/node_modules
frontend/node_modules/
.worktrees/
# TLS private keys and operator-provided certificate chains never enter Git.
certs/

# FIX-5: eigener Wegwerf-Stack (Compose-Projekt fix5r2) — Daten und Env bleiben lokal.
.fix5r2.env
compose/.fix5r2/

# FIX-6b: eigener Wegwerf-Stack (Compose-Projekt fix6b) — Env bleibt lokal.
.env.fix6b
compose/.fix6b/

# WEB-8c (R6): versehentlich committete Zwischenablage (Hilfsdatei) — nie wieder.
.uxa2b-tmp/
frontend/.uxa2b-tmp/

# WEB-8c: eigener Wegwerf-Stack (Compose-Projekt web8c) — Env und Daten bleiben lokal.
compose/.web8c.env
compose/.web8c/

# FE-TEST-1: eigene Auswahl-Datei fuer gezielte Builds (nur lokal).
# docker build -f backend/Dockerfile --build-arg NODE_TESTLISTE=tests/.auswahl.txt ..
frontend/tests/.auswahl.txt

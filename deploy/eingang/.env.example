# WEB-4 — Beispiel-Konfiguration fuer deploy/eingang/compose.yml
#
# Kopieren nach `.env` und anpassen:
#   cp .env.example .env && chmod 600 .env
# Die .env steht in .gitignore und gehoert NICHT ins Repository.
# Hier stehen KEINE Geheimnisse — der Eingang braucht keine.

# ── Adresse des Eingangs ───────────────────────────────────────────────────
# 127.0.0.1 = nur lokal; davor steht der zentrale Reverse-Proxy (NPM) mit TLS
# und Cert. Eine LAN-IP (z. B. 192.168.1.11) nur, wenn der Proxy auf einem
# anderen Host laeuft.
EINGANG_BIND_ADDR=127.0.0.1
EINGANG_PORT=8120

# ── Upstreams ──────────────────────────────────────────────────────────────
# Diakronos (Gemeinde-App). Laeuft mit DIAKRONOS_BASE_PATH=/diakronos und
# liefert App, Login, API, Dateien, Registrierung und WebSocket unter dem
# Praefix aus (Karten WEB-5a/5b).
EINGANG_DIAKRONOS_UPSTREAM=192.168.1.11:8110

# Primo-Vorbau aus deploy/primo (liefert die Website per Host-Header,
# /admin/ = Editor, /api/ = PocketBase, /diakronos-sso.html).
EINGANG_PRIMO_UPSTREAM=192.168.1.11:8095

# ── Pfade ──────────────────────────────────────────────────────────────────
# Praefix aller Diakronos-Funktionen. OHNE Schraegstrich am Ende; der Eingang
# reicht den Pfad UNVERAENDERT durch (kein Strippen).
EINGANG_DIAKRONOS_PRAEFIX=/diakronos

# Ziel von /login (302) und des Rueckfalls, wenn ein Host keine Website hat.
EINGANG_LOGIN_PFAD=/diakronos/login

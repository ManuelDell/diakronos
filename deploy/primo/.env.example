# WEB-2 — Beispiel-Konfiguration fuer deploy/primo/compose.yml
#
# Kopieren nach `.env` und ausfuellen:
#   cp .env.example .env && chmod 600 .env
# Die .env steht in .gitignore und gehoert NICHT ins Repository.
#
# Platzhalter unten sind absichtlich leer bzw. unbrauchbar ("BITTE-…"):
# die Datei enthaelt keine echten Kennwoerter.

# ── Erstbetrieb: Superuser (PocketBase-Backend unter /_/) ───────────────────
# Wird NUR beim ersten Start mit leerem pb_data angelegt.
PRIMO_SUPERUSER_EMAIL=BITTE-AENDERN@example.org
PRIMO_SUPERUSER_PASSWORD=BITTE-EIN-LANGES-KENNWORT-EINTRAGEN

# ── Erstbetrieb: erster Server-Benutzer von Primo (Rolle developer) ────────
# Dieser Account braucht Diakronos als Integrationskonto: nur mit der
# Server-Rolle `developer` darf es Nutzer und Site-Zuordnungen anlegen
# (sites/users createRule = serverRole != "").
PRIMO_USER_EMAIL=BITTE-AENDERN@example.org
PRIMO_USER_PASSWORD=BITTE-EIN-LANGES-KENNWORT-EINTRAGEN

# ── Netz ───────────────────────────────────────────────────────────────────
# Port des Vorbaus auf der Loopback-Adresse des Hosts. Danach zeigt der
# zentrale Reverse-Proxy (z. B. Nginx Proxy Manager) auf 127.0.0.1:<Port>.
PRIMO_HTTP_PORT=8095

# ── Sicherung ──────────────────────────────────────────────────────────────
# Cron-Ausdruck (Ortszeit des Containers) fuer die eingebaute pb_data-Sicherung.
# Beispiel: taeglich 03:00. "0 0 31 2 *" waere "nie".
PRIMO_BACKUP_CRON=0 3 * * *
TZ=Europe/Berlin

# Adresse, an die der Vorbau bindet. 127.0.0.1 = nur lokal (z. B. hinter Nginx Proxy Manager auf demselben Host);
# LAN-IP (z. B. 192.168.1.11), wenn ein Proxy auf einem anderen Host oder der Browser direkt zugreift.
PRIMO_BIND_ADDR=127.0.0.1
